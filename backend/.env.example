# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/salon

# JWT Secret Key for Admin Authentication (Required for login token generation)
JWT_SECRET=supersecretkey_salon_jwt_token_change_in_production

# Optional: Nodemailer Email Settings (For appointment confirmation/update emails)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
